{
	"name": "casai",
	"version": "0.6.2",
	"description": "Orchestrate AI agent workflows with Nunjucks-style text templates that implicitly run async tasks concurrently",
	"author": "Angel Popov<geleto@gmail.com>",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/geleto/casai.git"
	},
	"homepage": "https://github.com/geleto/casai#readme",
	"bugs": {
		"url": "https://github.com/geleto/casai/issues"
	},
	"keywords": [
		"ai",
		"agent",
		"vercel",
		"template",
		"async",
		"concurrent",
		"concurrency",
		"llm",
		"orchestration",
		"workflow",
		"nunjucks",
		"templates"
	],
	"files": [
		"dist",
		"src",
		"!dist/.tsbuildinfo",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"casai-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.js"
		},
		"./dist/*": {
			"types": "./dist/*"
		}
	},
	"imports": {
		"#tool-audio-download": {
			"casai-source": {
				"node": "./src/audio/tool-download.node.ts",
				"default": "./src/audio/tool-download.web.ts"
			},
			"node": "./dist/audio/tool-download.node.js",
			"default": "./dist/audio/tool-download.web.js"
		},
		"#pcm-worker": {
			"casai-source": {
				"node": "./src/audio/pcm-worker.node.ts",
				"default": "./src/audio/pcm-worker.web.ts"
			},
			"node": "./dist/audio/pcm-worker.node.js",
			"default": "./dist/audio/pcm-worker.web.js"
		},
		"#prepared-audio": {
			"casai-source": {
				"node": "./src/audio/native.ts",
				"browser": "./src/audio/browser.ts",
				"default": "./src/audio/unavailable.ts"
			},
			"node": "./dist/audio/native.js",
			"browser": "./dist/audio/browser.js",
			"default": "./dist/audio/unavailable.js"
		}
	},
	"scripts": {
		"build": "node scripts/build-audio-workers.mjs && tsc -b tsconfig.build.json",
		"build:tsc": "node scripts/build-audio-workers.mjs && tsc -b tsconfig.build.json",
		"clean": "rimraf dist",
		"lint": "node --max-old-space-size=8192 --max-semi-space-size=64 scripts/lint.mjs",
		"lint:full": "npm run lint -- --fresh",
		"lint:files": "node --max-old-space-size=8192 --max-semi-space-size=64 node_modules/eslint/bin/eslint.js",
		"typecheck": "tsc -p tsconfig.consumers.json --incremental --tsBuildInfoFile node_modules/.cache/casai/consumers.tsbuildinfo",
		"typecheck:src": "tsc -p tsconfig.source.json --incremental --tsBuildInfoFile node_modules/.cache/casai/source.tsbuildinfo",
		"typecheck:safety:src": "tsc -p tests/type-safety/tsconfig.source.json --incremental --tsBuildInfoFile node_modules/.cache/casai/safety-source.tsbuildinfo",
		"typecheck:exact": "tsc -p tests/type-safety --incremental --tsBuildInfoFile node_modules/.cache/casai/safety-exact.tsbuildinfo",
		"test": "npm run test:local",
		"test:live": "npm run test:file -- tests/Loaders.test.ts tests/Messages.test.ts tests/LLMAgentOutput.live.test.ts tests/LLMAgentOutputStream.live.test.ts tests/Script.test.ts tests/LLMAgent.live.test.ts tests/LLMAgentStream.live.test.ts tests/Tools.test.ts",
		"test:types": "node scripts/build-audio-workers.mjs && node tests/fixtures/readme2-examples.cjs && npm run typecheck:src && npm run build && node tests/fixtures/component-declarations.cjs && npm run typecheck && npm run typecheck:exact",
		"test:local": "node scripts/build-audio-workers.mjs && mocha",
		"test:native": "node tests/fixtures/native-audio-interface.cjs && npm run test:file -- tests/NativeAudio.integration.test.ts && node --import tsx/esm --conditions=casai-source --test tests/fixtures/phase6-ab-evaluation.mjs && node tests/fixtures/phase6-node-bundles.mjs --present",
		"test:native:release": "npm run build && node tests/fixtures/native-audio-release.mjs && npm run test:native",
		"test:native:release:gpl": "npm run build && node tests/fixtures/native-audio-release.mjs --gpl && npm run test:native",
		"test:audio:live": "npm run test:file -- tests/Phase6Audio.live.test.ts",
		"test:media:browser": "node scripts/build-audio-workers.mjs && node --test tests/fixtures/browser-media-contracts.test.mjs",
		"test:media-tools:live": "npm run test:file -- tests/Phase6MediaTools.live.test.ts",
		"test:matrix": "node --import tsx/esm --conditions=casai-source tests/fixtures/matrix-runtime.mjs",
		"test:matrix:native": "node --import tsx/esm --conditions=casai-source tests/fixtures/matrix-runtime.mjs --native",
		"test:native:mutations": "node tests/fixtures/phase6-native-mutations.cjs",
		"docs:matrix": "node scripts/update-matrix-reference.mjs",
		"docs:matrix:export": "node scripts/export-matrix.mjs",
		"test:component-mutations": "node tests/fixtures/component-review-mutations.cjs",
		"test:file": "node scripts/build-audio-workers.mjs && mocha --no-config --node-option import=tsx/esm --node-option conditions=casai-source --require dotenv/config",
		"test:coverage": "c8 npm run test:local -- --timeout 10000 --reporter dot && c8 check-coverage --include src/runtime/augment-result.ts --per-file --lines 100 --statements 100 --functions 100 --branches 98",
		"test:phase2-production": "node tests/fixtures/phase2-factory-cost.cjs && node tests/fixtures/phase2-production-editor.cjs && node tests/fixtures/phase2-production-mutations.cjs && node tests/fixtures/phase2-production-types.cjs",
		"test:package": "npm run build && node tests/fixtures/phase2-package-consumer.cjs",
		"test:watch": "npm run test:local -- --watch",
		"test:checks": "node --test tests/fixtures/check-workflow.test.mjs tests/fixtures/documentation-workflows.test.mjs",
		"check": "npm run test:checks && npm run test:types && npm run test:matrix && npm run lint && npm run test:coverage"
	},
	"c8": {
		"all": true,
		"include": [
			"src/*.ts",
			"src/audio/pcm.ts",
			"src/audio/pcm-format.ts",
			"src/audio/pcm-stream.ts",
			"src/audio/pcm-resample.ts",
			"src/audio/pcm-pool.ts",
			"src/audio/preparation.ts",
			"src/audio/input.ts",
			"src/audio/supplied.ts",
			"src/audio/transcription-file.ts",
			"src/audio/source-evidence.ts",
			"src/audio/browser.ts",
			"src/audio/unavailable.ts",
			"src/factories/*.ts",
			"src/config/*.ts",
			"src/renderers/*.ts",
			"src/runtime/*.ts",
			"src/types/merge.ts"
		],
		"reporter": [
			"text",
			"json",
			"json-summary",
			"html"
		],
		"check-coverage": true,
		"lines": 99,
		"statements": 99,
		"functions": 100,
		"branches": 95
	},
	"devDependencies": {
		"@ai-sdk/anthropic": "^4.0.110",
		"@ai-sdk/elevenlabs": "3.0.90",
		"@ai-sdk/google": "4.0.128",
		"@ai-sdk/openai": "^4.0.125",
		"@babel/core": "^8.0.7",
		"@babel/preset-env": "^8.0.7",
		"@eslint/js": "^10.0.1",
		"@types/chai": "^5.2.3",
		"@types/chai-as-promised": "^8.0.2",
		"@types/mocha": "^10.0.10",
		"@types/node": "^26.6.4",
		"@typescript-eslint/eslint-plugin": "^8.71.1",
		"@typescript-eslint/parser": "^8.71.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"ai": "^7.0.183",
		"audio-buffer": "^7.3.2",
		"c8": "^12.0.0",
		"chai": "^6.3.0",
		"chai-as-promised": "^8.0.2",
		"dotenv": "^18.0.6",
		"esbuild": "^0.28.2",
		"eslint": "^10.12.0",
		"mocha": "^12.0.3",
		"rimraf": "^6.1.3",
		"tsx": "^4.23.15",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.71.1",
		"vscode-jsonrpc": "^10.0.0",
		"zod": "4.6.5"
	},
	"engines": {
		"node": ">=24",
		"npm": ">=9.0.0"
	},
	"dependencies": {
		"@ai-sdk/provider-utils": "^5.0.85",
		"cascada-engine": "^0.7.0",
		"guarded-fetch": "^0.3.0"
	},
	"peerDependencies": {
		"ai": "^7.0.183",
		"node-av": "^7.1.0",
		"zod": "^4.6.5"
	},
	"peerDependenciesMeta": {
		"node-av": {
			"optional": true
		}
	},
	"overrides": {
		"mocha": {
			"diff": "^9.0.0",
			"serialize-javascript": "^7.1.2"
		}
	}
}
