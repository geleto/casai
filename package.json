{
	"name": "casai",
	"version": "0.6.2",
	"description": "Orchestrate AI agent workflows with Nunjucks-style text templates that implicitly run async tasks concurrently",
	"author": "Angel Popov<geleto@gmail.com>",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/geleto/casai.git"
	},
	"homepage": "https://github.com/geleto/casai#readme",
	"bugs": {
		"url": "https://github.com/geleto/casai/issues"
	},
	"keywords": [
		"ai",
		"agent",
		"vercel",
		"template",
		"async",
		"concurrent",
		"concurrency",
		"llm",
		"orchestration",
		"workflow",
		"nunjucks",
		"templates"
	],
	"files": [
		"dist",
		"!dist/.tsbuildinfo",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"casai-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -b tsconfig.build.json",
		"build:tsc": "tsc -b tsconfig.build.json",
		"clean": "rimraf dist",
		"lint": "node --max-old-space-size=8192 node_modules/eslint/bin/eslint.js src tests",
		"typecheck": "tsc -p tsconfig.consumers.json --incremental --tsBuildInfoFile node_modules/.cache/casai/consumers.tsbuildinfo",
		"typecheck:src": "tsc -p tsconfig.source.json --incremental --tsBuildInfoFile node_modules/.cache/casai/source.tsbuildinfo",
		"typecheck:safety:src": "tsc -p tests/type-safety/tsconfig.source.json --incremental --tsBuildInfoFile node_modules/.cache/casai/safety-source.tsbuildinfo",
		"typecheck:exact": "tsc -p tests/type-safety --incremental --tsBuildInfoFile node_modules/.cache/casai/safety-exact.tsbuildinfo",
		"test": "npm run test:local",
		"test:live": "npm run test:file -- tests/Loaders.test.ts tests/Messages.test.ts tests/ObjectGenerator.test.ts tests/ObjectStreamer.test.ts tests/Script.test.ts tests/TextGenerator.test.ts tests/TextStreamer.test.ts tests/Tools.test.ts",
		"test:types": "npm run typecheck:src && npm run build && npm run typecheck && npm run typecheck:exact",
		"test:local": "mocha",
		"test:file": "mocha --no-config --node-option import=tsx/esm --node-option conditions=casai-source --require dotenv/config",
		"test:coverage": "c8 npm run test:local -- --timeout 10000 --reporter dot && c8 check-coverage --include src/augment-result.ts --per-file --lines 100 --statements 100 --functions 100 --branches 98",
		"test:phase2-production": "node tests/fixtures/phase2-factory-cost.cjs && node tests/fixtures/phase2-production-editor.cjs && node tests/fixtures/phase2-production-mutations.cjs && node tests/fixtures/phase2-production-types.cjs",
		"test:package": "npm run build && node tests/fixtures/phase2-package-consumer.cjs",
		"test:watch": "npm run test:local -- --watch",
		"check": "npm run test:types && npm run lint && npm run test:coverage",
		"start": "tsx examples/story.ts"
	},
	"c8": {
		"all": true,
		"include": [
			"src/*.ts",
			"src/factories/*.ts",
			"src/types/merge.ts"
		],
		"reporter": [
			"text",
			"json",
			"json-summary",
			"html"
		],
		"check-coverage": true,
		"lines": 99,
		"statements": 99,
		"functions": 100,
		"branches": 95
	},
	"devDependencies": {
		"@ai-sdk/anthropic": "^4.0.74",
		"@ai-sdk/openai": "^4.0.86",
		"@babel/core": "^8.0.7",
		"@babel/preset-env": "^8.0.7",
		"@eslint/js": "^10.0.1",
		"@types/chai": "^5.2.3",
		"@types/chai-as-promised": "^8.0.2",
		"@types/mocha": "^10.0.10",
		"@types/node": "^26.6.4",
		"@typescript-eslint/eslint-plugin": "^8.71.1",
		"@typescript-eslint/parser": "^8.71.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"ai": "^7.0.130",
		"c8": "^12.0.0",
		"chai": "^6.3.0",
		"chai-as-promised": "^8.0.2",
		"dotenv": "^18.0.6",
		"eslint": "^10.12.0",
		"mocha": "^12.0.3",
		"rimraf": "^6.1.3",
		"tsx": "^4.23.15",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.71.1",
		"vscode-jsonrpc": "^10.0.0",
		"zod": "4.6.5"
	},
	"engines": {
		"node": ">=24",
		"npm": ">=9.0.0"
	},
	"dependencies": {
		"@ai-sdk/provider-utils": "^5.0.56",
		"cascada-engine": "^0.6.2"
	},
	"peerDependencies": {
		"ai": "^7.0.130",
		"zod": "^4.6.5"
	},
	"overrides": {
		"mocha": {
			"diff": "^9.0.0",
			"serialize-javascript": "^7.1.2"
		}
	}
}
