{
	"name": "casai",
	"version": "0.6.2",
	"description": "Orchestrate AI agent workflows with Nunjucks-style text templates that implicitly run async tasks concurrently",
	"author": "Angel Popov<geleto@gmail.com>",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/geleto/casai.git"
	},
	"homepage": "https://github.com/geleto/casai#readme",
	"bugs": {
		"url": "https://github.com/geleto/casai/issues"
	},
	"keywords": [
		"ai",
		"agent",
		"vercel",
		"template",
		"async",
		"concurrent",
		"concurrency",
		"llm",
		"orchestration",
		"workflow",
		"nunjucks",
		"templates"
	],
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"casai-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"build:tsc": "tsc -p tsconfig.build.json",
		"clean": "rimraf dist",
		"lint": "eslint src tests",
		"typecheck": "tsc --noEmit",
		"test": "npm run build && mocha",
		"test:file": "mocha --no-config --node-option import=tsx --node-option conditions=casai-source --require dotenv/config",
		"test:watch": "mocha --watch",
		"test-type": "eslint tests/type-safety",
		"start": "tsx examples/story.ts"
	},
	"devDependencies": {
		"@ai-sdk/anthropic": "^4.0.74",
		"@ai-sdk/openai": "^4.0.86",
		"@babel/core": "^8.0.7",
		"@babel/preset-env": "^8.0.7",
		"@eslint/js": "^10.0.1",
		"@types/chai": "^5.2.3",
		"@types/chai-as-promised": "^8.0.2",
		"@types/mocha": "^10.0.10",
		"@types/node": "^26.6.4",
		"@typescript-eslint/eslint-plugin": "^8.71.1",
		"@typescript-eslint/parser": "^8.71.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"ai": "^7.0.130",
		"chai": "^6.3.0",
		"chai-as-promised": "^8.0.2",
		"dotenv": "^18.0.6",
		"eslint": "^10.12.0",
		"mocha": "^12.0.3",
		"rimraf": "^6.1.3",
		"tsx": "^4.23.15",
		"typescript-eslint": "^8.71.1"
	},
	"engines": {
		"node": ">=22.18.0",
		"npm": ">=9.0.0"
	},
	"dependencies": {
		"cascada-engine": "^0.6.2",
		"ts-node": "^10.9.2",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	},
	"peerDependencies": {
		"ai": "^7.0.0"
	},
	"overrides": {
		"mocha": {
			"diff": "^9.0.0",
			"serialize-javascript": "^7.1.2"
		}
	}
}
