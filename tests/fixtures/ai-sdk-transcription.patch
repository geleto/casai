@@ -0,0 +1,142 @@
+import type {
+  Experimental_TranscriptionModelV4StreamPart as StreamPart,
+  SharedV4Warning,
+} from '@ai-sdk/provider';
+import {
+  createEventSourceResponseHandler,
+  lazySchema,
+  zodSchema,
+  type InferSchema,
+  type ParseResult,
+} from '@ai-sdk/provider-utils';
+import { z } from 'zod/v4';
+
+const eventSchema = lazySchema(() =>
+  zodSchema(
+    z.object({
+      type: z.string(),
+      delta: z.string().nullish(),
+      text: z.string().nullish(),
+      segment_id: z.string().nullish(),
+      id: z.string().nullish(),
+      start: z.number().nullish(),
+      end: z.number().nullish(),
+      speaker: z.string().nullish(),
+      languages: z.array(z.object({ code: z.string() })).nullish(),
+      usage: z.record(z.string(), z.json()).nullish(),
+      error: z.object({ message: z.string() }).nullish(),
+      message: z.string().nullish(),
+    }),
+  ),
+);
+export const fileTranscriptResponseHandler =
+  createEventSourceResponseHandler(eventSchema);
+
+export function fileTranscriptStream(
+  events: ReadableStream<ParseResult<InferSchema<typeof eventSchema>>>,
+  warnings: SharedV4Warning[],
+  raw = false,
+) {
+  const segments: {
+    text: string;
+    startSecond: number;
+    endSecond: number;
+    speaker: string;
+  }[] = [];
+  return events.pipeThrough(
+    new TransformStream<
+      ParseResult<InferSchema<typeof eventSchema>>,
+      StreamPart
+    >({
+      start(controller) {
+        controller.enqueue({ type: 'stream-start', warnings });
+      },
+      transform(parsed, controller) {
+        if (!parsed.success) throw parsed.error;
+        const event = parsed.value;
+        if (raw) controller.enqueue({ type: 'raw', rawValue: parsed.rawValue });
+        switch (event.type) {
+          case 'transcript.text.delta':
+            if (event.delta == null)
+              throw new Error('Missing OpenAI transcript delta.');
+            controller.enqueue({
+              type: 'transcript-delta',
+              delta: event.delta,
+              id: event.segment_id ?? undefined,
+            });
+            break;
+          case 'transcript.text.segment': {
+            if (
+              event.text == null ||
+              event.start == null ||
+              event.end == null ||
+              event.id == null ||
+              event.speaker == null
+            ) {
+              throw new Error('Incomplete OpenAI diarized transcript segment.');
+            }
+            const segment = {
+              text: event.text,
+              startSecond: event.start,
+              endSecond: event.end,
+            };
+            segments.push({ ...segment, speaker: event.speaker });
+            controller.enqueue({
+              type: 'transcript-final',
+              id: event.id,
+              ...segment,
+              providerMetadata: { openai: { speaker: event.speaker } },
+            });
+            break;
+          }
+          case 'transcript.text.done': {
+            if (event.text == null)
+              throw new Error('Missing OpenAI final transcript.');
+            const usage = event.usage ?? undefined;
+            controller.enqueue({
+              type: 'finish',
+              text: event.text,
+              segments: segments.map(({ text, startSecond, endSecond }) => ({
+                text,
+                startSecond,
+                endSecond,
+              })),
+              language:
+                event.languages?.length === 1
+                  ? event.languages[0].code
+                  : undefined,
+              durationInSeconds:
+                usage?.type === 'duration' && typeof usage.seconds === 'number'
+                  ? usage.seconds
+                  : undefined,
+              usage,
+              ...((segments.length > 0 || event.languages != null) && {
+                providerMetadata: {
+                  openai: {
+                    ...(segments.length > 0 && { segments }),
+                    ...(event.languages != null && {
+                      languages: event.languages,
+                    }),
+                  },
+                },
+              }),
+            });
+            controller.terminate();
+            break;
+          }
+          case 'error':
+            throw new Error(
+              event.error?.message ??
+                event.message ??
+                'OpenAI file transcription failed.',
+            );
+        }
+      },
+      flush() {
+        throw new Error(
+          'OpenAI file transcription ended before transcript.text.done.',
+        );
+      },
+    }),
+  );
+}
