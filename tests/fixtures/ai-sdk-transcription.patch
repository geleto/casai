@@ -0,0 +1,66 @@
+import type { Experimental_TranscriptionModelV4StreamPart as StreamPart } from '@ai-sdk/provider';
+import {
+  lazySchema,
+  validateTypes,
+  zodSchema,
+  type InferSchema,
+} from '@ai-sdk/provider-utils';
+import { z } from 'zod/v4';
+
+const fluxTurnSchema = lazySchema(() =>
+  zodSchema(
+    z.object({
+      event: z.enum([
+        'StartOfTurn',
+        'Update',
+        'EagerEndOfTurn',
+        'TurnResumed',
+        'EndOfTurn',
+      ]),
+      turn_index: z.number().int().nonnegative(),
+      audio_window_start: z.number(),
+      audio_window_end: z.number(),
+      transcript: z.string(),
+      words: z
+        .array(
+          z.object({
+            word: z.string(),
+            start: z.number().nullish(),
+            end: z.number().nullish(),
+          }),
+        )
+        .nullish(),
+    }),
+  ),
+);
+export type FluxTurn = InferSchema<typeof fluxTurnSchema>;
+export const readFluxTurn = (value: unknown) =>
+  validateTypes({ value, schema: fluxTurnSchema });
+
+export function reportFluxTurn(
+  controller: ReadableStreamDefaultController<StreamPart>,
+  turn: FluxTurn,
+  final: boolean,
+) {
+  const shared = {
+    id: String(turn.turn_index),
+    text: turn.transcript,
+    startSecond: turn.audio_window_start,
+    providerMetadata: {
+      deepgram: { event: turn.event, turnIndex: turn.turn_index },
+    },
+  };
+  controller.enqueue(
+    final
+      ? {
+          type: 'transcript-final',
+          ...shared,
+          endSecond: turn.audio_window_end,
+        }
+      : {
+          type: 'transcript-partial',
+          ...shared,
+          durationInSeconds: turn.audio_window_end - turn.audio_window_start,
+        },
+  );
+}
