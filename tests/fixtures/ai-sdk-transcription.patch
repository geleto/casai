index 0000000000000000000000000000000000000000..f0b2c36bc66ebd1ab3f87858b682975c9b05d21c
--- /dev/null
+++ b/packages/ai/src/transcribe/transcription-file.ts
@@ -0,0 +1,152 @@
+import {
+  InvalidArgumentError,
+  type TranscriptionModelV4File,
+} from '@ai-sdk/provider';
+import { isUint8Array } from '@ai-sdk/provider-utils';
+
+/** Describe one encoded recording. File/Blob metadata is the default and explicit metadata wins. */
+export function transcriptionFile(
+  data: Blob,
+  options?: { mediaType?: string; filename?: string },
+): TranscriptionModelV4File;
+export function transcriptionFile(
+  data: TranscriptionModelV4File['data'],
+  options: { mediaType: string; filename?: string },
+): TranscriptionModelV4File;
+export function transcriptionFile(
+  data: TranscriptionModelV4File['data'],
+  {
+    mediaType: suppliedType,
+    filename,
+  }: { mediaType?: string; filename?: string } = {},
+): TranscriptionModelV4File {
+  if (
+    data == null ||
+    typeof data !== 'object' ||
+    !(
+      isUint8Array(data) ||
+      ('getReader' in data && typeof data.getReader === 'function') ||
+      ('slice' in data &&
+        'stream' in data &&
+        typeof data.slice === 'function' &&
+        typeof data.stream === 'function')
+    )
+  ) {
+    throw new InvalidArgumentError({
+      argument: 'audio',
+      message: 'Supply a Blob, Uint8Array or ReadableStream for the recording.',
+    });
+  }
+  const mediaType = suppliedType ?? ('type' in data ? data.type : '');
+  if (
+    !/^[\w!#$%&'*+.^|~-]+\/[\w!#$%&'*+.^|~-]+(?:\s*;[^\r\n]*)?$/.test(
+      mediaType,
+    ) ||
+    /[^\x20-\x7e]/.test(mediaType)
+  ) {
+    throw new InvalidArgumentError({
+      argument: 'mediaType',
+      message: 'Supply a complete MIME type for the recording.',
+    });
+  }
+  if (
+    filename != null &&
+    (typeof filename !== 'string' ||
+      filename.length === 0 ||
+      Array.from(filename).some(
+        char => char.charCodeAt(0) < 32 || char.charCodeAt(0) === 127,
+      ))
+  ) {
+    throw new InvalidArgumentError({
+      argument: 'filename',
+      message: 'Supply a nonempty filename without control characters.',
+    });
+  }
+  return {
+    type: 'file',
+    data,
+    mediaType,
+    ...(filename != null && { filename }),
+  };
+}
+
+export function isTranscriptionFile(
+  value: unknown,
+): value is TranscriptionModelV4File {
+  return (
+    typeof value === 'object' &&
+    value !== null &&
+    'type' in value &&
+    value.type === 'file' &&
+    'data' in value
+  );
+}
+
+const handedOff = new WeakSet<ReadableStream<Uint8Array>>();
+
+/** The execution can release a pending producer even if fetch still owns its request reader. */
+export function openTranscriptionFile(
+  file: TranscriptionModelV4File,
+  onBytes?: (size: number) => void,
+) {
+  const source = file.data;
+  if (!('getReader' in source)) return { file, close: undefined };
+  if (source.locked || handedOff.has(source)) {
+    throw new InvalidArgumentError({
+      argument: 'audio',
+      message: 'The recording stream is locked or has already been handed off.',
+    });
+  }
+  handedOff.add(source);
+  const reader = source.getReader();
+  let released = false;
+  const close = async (reason?: unknown) => {
+    if (released) return;
+    released = true;
+    try {
+      await reader.cancel(reason);
+    } finally {
+      reader.releaseLock();
+    }
+  };
+  const data = new ReadableStream<Uint8Array>(
+    {
+      async pull(controller) {
+        if (released) {
+          controller.close();
+          return;
+        }
+        try {
+          const item = await reader.read();
+          if (item.done || released) {
+            if (!released) {
+              released = true;
+              reader.releaseLock();
+            }
+            controller.close();
+          } else {
+            onBytes?.(item.value.byteLength);
+            controller.enqueue(item.value);
+          }
+        } catch (error) {
+          if (!released) {
+            released = true;
+            reader.releaseLock();
+          }
+          controller.error(error);
+        }
+      },
+      cancel: close,
+    },
+    { highWaterMark: 0 },
+  );
+  return { file: { ...file, data }, close };
+}
+
+export function fileByteLength(file: TranscriptionModelV4File) {
+  return isUint8Array(file.data)
+    ? file.data.byteLength
+    : 'size' in file.data
+      ? file.data.size
+      : undefined;
+}
