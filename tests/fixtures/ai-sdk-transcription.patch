--- /dev/null
+++ b/examples/ai-functions/src/stream-transcribe/openai/recorded-file.ts
@@ -0,0 +1,17 @@
+import { openAsBlob } from 'node:fs';
+import { openai } from '@ai-sdk/openai';
+import {
+  experimental_streamTranscribe as streamTranscribe,
+  transcriptionFile,
+} from 'ai';
+
+const recording = await openAsBlob(process.argv[2], { type: 'audio/mp4' });
+const result = streamTranscribe({
+  model: openai.transcription('gpt-4o-mini-transcribe'),
+  audio: transcriptionFile(recording, { filename: 'interview.m4a' }),
+});
+
+for await (const part of result.fullStream) {
+  if (part.type === 'transcript-delta') process.stdout.write(part.delta);
+}
+console.log(await result.text);
