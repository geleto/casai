+import type { TranscriptionModelV4File } from '@ai-sdk/provider';
+import { isArrayBuffer, isUint8Array } from './uint8-utils';
+import { mediaTypeToExtension } from './media-type-to-extension';
+import {
+  postMultipartStreamToApi,
+  type MultipartStreamPart,
+} from './post-multipart-stream-to-api';
+import { postFormDataToApi } from './post-to-api';
+
+/** Append an encoded recording to the provider's scalar multipart fields. */
+export function postTranscriptionFileToApi<T>({
+  file,
+  formData,
+  ...request
+}: Parameters<typeof postFormDataToApi<T>>[0] & {
+  file: TranscriptionModelV4File;
+}) {
+  const { data, mediaType } = file;
+  const filename =
+    file.filename ??
+    ('name' in data && typeof data.name === 'string' && data.name.length > 0
+      ? data.name
+      : `audio.${mediaTypeToExtension(mediaType.split(';')[0])}`);
+  if ('getReader' in data) {
+    const parts: MultipartStreamPart[] = [];
+    formData.forEach((value, name) =>
+      parts.push({ type: 'field', name, value: String(value) }),
+    );
+    parts.push({
+      type: 'file',
+      name: 'file',
+      filename,
+      mediaType,
+      content: data,
+    });
+    return postMultipartStreamToApi({ ...request, parts });
+  }
+  const blob = isUint8Array(data)
+    ? new Blob(
+        [
+          isArrayBuffer(data.buffer)
+            ? (data as Uint8Array<ArrayBuffer>)
+            : new Uint8Array(data),
+        ],
+        { type: mediaType },
+      )
+    : data.type === mediaType
+      ? data
+      : data.slice(0, data.size, mediaType);
+  formData.append('file', blob, filename);
+  return postFormDataToApi({ ...request, formData });
+}
