+import { convertReadableStreamToArray } from '@ai-sdk/provider-utils/test';
+import { describe, expect, it, vi } from 'vitest';
+import { createOpenAI } from '../openai-provider';
+
+const data = new File(['recording'], 'interview.original', {
+  type: 'audio/mp4',
+});
+const audio = { type: 'file' as const, data, mediaType: 'audio/mp4' };
+const encoder = new TextEncoder();
+const sse = (value: unknown) =>
+  encoder.encode('data: ' + JSON.stringify(value) + '\n\n');
+
+describe('OpenAI file transcript SSE', () => {
+  it('publishes deltas before done, preserves speakers, and treats done text as authoritative', async () => {
+    let source!: ReadableStreamDefaultController<Uint8Array>;
+    const cancel = vi.fn();
+    const fetch = vi.fn<typeof globalThis.fetch>(async (url, init) => {
+      expect(String(url)).toMatch(/\/audio\/transcriptions$/);
+      const form = init!.body as FormData;
+      expect(form.get('stream')).toBe('true');
+      expect(form.get('response_format')).toBe('diarized_json');
+      const file = form.get('file') as File;
+      expect([file.name, file.type, await file.text()]).toEqual([
+        'interview.original',
+        'audio/mp4',
+        'recording',
+      ]);
+      return new Response(
+        new ReadableStream({
+          start(c) {
+            source = c;
+          },
+          cancel,
+        }),
+      );
+    });
+    const result = await createOpenAI({ apiKey: 'test', fetch }).transcription(
+      'gpt-4o-transcribe-diarize',
+    ).doStreamFromFile!({ audio });
+    const reader = result.stream.getReader();
+    expect((await reader.read()).value).toMatchObject({ type: 'stream-start' });
+    source.enqueue(
+      sse({ type: 'transcript.text.delta', delta: 'hel', segment_id: 's1' }),
+    );
+    expect((await reader.read()).value).toEqual({
+      type: 'transcript-delta',
+      delta: 'hel',
+      id: 's1',
+    });
+    source.enqueue(
+      sse({
+        type: 'transcript.text.segment',
+        text: 'Hello',
+        start: 0,
+        end: 1,
+        id: 's1',
+        speaker: 'A',
+      }),
+    );
+    expect((await reader.read()).value).toMatchObject({
+      type: 'transcript-final',
+      text: 'Hello',
+      providerMetadata: { openai: { speaker: 'A' } },
+    });
+    source.enqueue(
+      sse({
+        type: 'transcript.text.done',
+        text: 'Hello!',
+        languages: [{ code: 'en' }],
+        usage: { type: 'duration', seconds: 1 },
+      }),
+    );
+    expect((await reader.read()).value).toMatchObject({
+      type: 'finish',
+      text: 'Hello!',
+      language: 'en',
+      durationInSeconds: 1,
+      segments: [{ text: 'Hello', startSecond: 0, endSecond: 1 }],
+    });
+    expect((await reader.read()).done).toBe(true);
+    await vi.waitFor(() => expect(cancel).toHaveBeenCalledOnce());
+    expect(fetch).toHaveBeenCalledOnce();
+  });
+
+  it.each([
+    [
+      'data: {"type":"transcript.text.delta","delta":"heard"}\n\n',
+      'before transcript.text.done',
+    ],
+    ['data: {"type":"error","error":{"message":"bad audio"}}\n\n', 'bad audio'],
+    [
+      'data: {"type":"transcript.text.delta"}\n\n',
+      'Missing OpenAI transcript delta',
+    ],
+    ['data: broken\n\n', 'JSON'],
+  ])('rejects a failed or incomplete SSE response', async (body, message) => {
+    const model = createOpenAI({
+      apiKey: 'test',
+      fetch: async () => new Response(body),
+    }).transcription('gpt-4o-mini-transcribe');
+    const { stream } = await model.doStreamFromFile!({ audio });
+    await expect(convertReadableStreamToArray(stream)).rejects.toThrow(message);
+  });
+
+  it.each(['whisper-1', 'gpt-live-transcribe', 'gpt-realtime-whisper'])(
+    'rejects unsupported file SSE on %s before fetching',
+    async id => {
+      const fetch = vi.fn();
+      const model = createOpenAI({ apiKey: 'test', fetch }).transcription(id);
+      await expect(model.doStreamFromFile!({ audio })).rejects.toThrow(
+        'streaming file transcription',
+      );
+      expect(fetch).not.toHaveBeenCalled();
+    },
+  );
+  it.skipIf(typeof SharedArrayBuffer === 'undefined')(
+    'uploads only the selected shared byte view and defaults QuickTime to .mov',
+    async () => {
+      const bytes = new Uint8Array(new SharedArrayBuffer(4));
+      bytes.set([0, 7, 3, 0]);
+      const model = createOpenAI({
+        apiKey: 'local',
+        fetch: async (_url, init) => {
+          const uploaded = (init!.body as FormData).get('file') as File;
+          expect(uploaded.name).toBe('audio.mov');
+          expect(uploaded.type).toBe('video/quicktime');
+          expect([...new Uint8Array(await uploaded.arrayBuffer())]).toEqual([
+            7, 3,
+          ]);
+          return Response.json({ text: 'done' });
+        },
+      }).transcription('gpt-4o-transcribe');
+      expect(
+        (
+          await model.doGenerateFromFile!({
+            audio: {
+              type: 'file',
+              data: bytes.subarray(1, 3),
+              mediaType: 'video/quicktime',
+            },
+          })
+        ).text,
+      ).toBe('done');
+    },
+  );
+});
