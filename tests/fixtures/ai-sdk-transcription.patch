+import { APICallError } from '@ai-sdk/provider';
+import { convertArrayToReadableStream } from '@ai-sdk/provider-utils/test';
+import { describe, expect, it, vi } from 'vitest';
+import { MockTranscriptionModelV4 } from '../test/mock-transcription-model-v4';
+import { transcribe } from './transcribe';
+import { streamTranscribe } from './stream-transcribe';
+import { transcriptionFile } from './transcription-file';
+
+const success = {
+  text: 'done',
+  segments: [],
+  language: undefined,
+  durationInSeconds: undefined,
+  warnings: [],
+  response: { timestamp: new Date(), modelId: 'test' },
+};
+const retryable = () =>
+  new APICallError({
+    message: 'retry',
+    url: 'https://example.test',
+    requestBodyValues: {},
+    statusCode: 503,
+    isRetryable: true,
+  });
+
+describe('transcriptionFile', () => {
+  it('retains a replayable File and retries with the same name and explicit MIME', async () => {
+    const data = new File(['payload'], 'meeting.xyz', { type: 'audio/mpeg' });
+    const audio = transcriptionFile(data, { mediaType: 'audio/mp4' });
+    const doGenerateFromFile = vi
+      .fn()
+      .mockRejectedValueOnce(retryable())
+      .mockResolvedValue(success);
+    const model = new MockTranscriptionModelV4({ doGenerateFromFile });
+    expect((await transcribe({ model, audio, maxRetries: 1 })).text).toBe(
+      'done',
+    );
+    expect(doGenerateFromFile).toHaveBeenCalledTimes(2);
+    for (const [call] of doGenerateFromFile.mock.calls) {
+      expect(call.audio.data).toBe(data);
+      expect(call.audio.mediaType).toBe('audio/mp4');
+    }
+  });
+
+  it('keeps one-shot input available after an invalid retry request, and never replays a failed upload', async () => {
+    const cancel = vi.fn();
+    const pull = vi.fn();
+    const audio = transcriptionFile(
+      new ReadableStream({ pull, cancel }, { highWaterMark: 0 }),
+      { mediaType: 'audio/ogg' },
+    );
+    const doGenerateFromFile = vi.fn().mockRejectedValue(retryable());
+    const model = new MockTranscriptionModelV4({ doGenerateFromFile });
+    for (const [maxRetries, message] of [
+      [-1, 'must be >= 0'],
+      [NaN, 'must be an integer'],
+      [0.5, 'must be an integer'],
+    ] as const) {
+      await expect(transcribe({ model, audio, maxRetries })).rejects.toThrow(
+        message,
+      );
+    }
+    await expect(transcribe({ model, audio, maxRetries: 2 })).rejects.toThrow(
+      'cannot be replayed',
+    );
+    expect(pull).not.toHaveBeenCalled();
+    expect(cancel).not.toHaveBeenCalled();
+    await expect(transcribe({ model, audio })).rejects.toThrow('retry');
+    expect(doGenerateFromFile).toHaveBeenCalledOnce();
+    expect(cancel).toHaveBeenCalledOnce();
+  });
+
+  it('reports missing adapter support before reading or locking the input', async () => {
+    const pull = vi.fn();
+    const audio = transcriptionFile(
+      new ReadableStream({ pull }, { highWaterMark: 0 }),
+      { mediaType: 'audio/mpeg' },
+    );
+    const model = new MockTranscriptionModelV4();
+    await expect(transcribe({ model, audio })).rejects.toThrow('file upload');
+    expect(() => streamTranscribe({ model, audio })).toThrow('from a file');
+    expect(pull).not.toHaveBeenCalled();
+  });
+
+  it('sends file streams through one native execution and reports actual input size to telemetry', async () => {
+    const onEnd = vi.fn();
+    const model = new MockTranscriptionModelV4({
+      doStreamFromFile: async ({ audio }) => {
+        expect(audio.filename).toBe('intro.container');
+        await new Response(
+          audio.data as ReadableStream<Uint8Array<ArrayBuffer>>,
+        ).arrayBuffer();
+        return {
+          stream: convertArrayToReadableStream([
+            { type: 'transcript-delta', delta: 'd' },
+            { type: 'finish', text: 'done', segments: [] },
+          ]),
+        };
+      },
+    });
+    const audio = transcriptionFile(
+      convertArrayToReadableStream([new Uint8Array(4), new Uint8Array(3)]),
+      { mediaType: 'audio/ogg', filename: 'intro.container' },
+    );
+    const result = streamTranscribe({
+      model,
+      audio,
+      telemetry: {
+        integrations: { experimental_onStreamTranscriptionEnd: onEnd },
+      },
+    });
+    const reader = result.fullStream.getReader();
+    expect((await reader.read()).value).toMatchObject({ delta: 'd' });
+    expect((await reader.read()).done).toBe(true);
+    expect(await result.text).toBe('done');
+    expect(onEnd.mock.calls[0][0].audio).toEqual({
+      byteLength: 7,
+      mediaType: 'audio/ogg',
+    });
+  });
+  it.each(['complete', 'stream'])(
+    'releases a source with a pending read on early %s success',
+    async delivery => {
+      const cancel = vi.fn();
+      const data = new ReadableStream<Uint8Array>(
+        { cancel },
+        { highWaterMark: 0 },
+      );
+      const audio = transcriptionFile(data, { mediaType: 'audio/ogg' });
+      const takeReader = (source: typeof audio) => {
+        const reader = (source.data as ReadableStream<Uint8Array>).getReader();
+        return reader.read().finally(() => reader.releaseLock());
+      };
+      let read: Promise<ReadableStreamReadResult<Uint8Array>> | undefined;
+      const model = new MockTranscriptionModelV4({
+        doGenerateFromFile: async ({ audio }) => {
+          read = takeReader(audio);
+          return success;
+        },
+        doStreamFromFile: async ({ audio }) => {
+          read = takeReader(audio);
+          return {
+            stream: convertArrayToReadableStream([
+              { type: 'finish', text: 'done', segments: [] },
+            ]),
+          };
+        },
+      });
+      const result =
+        delivery === 'complete'
+          ? await transcribe({ model, audio })
+          : streamTranscribe({ model, audio });
+      expect(await result.text).toBe('done');
+      await expect(read).resolves.toMatchObject({ done: true });
+      expect(cancel).toHaveBeenCalledOnce();
+      expect(data.locked).toBe(false);
+      await expect(transcribe({ model, audio })).rejects.toThrow(
+        'already been handed off',
+      );
+    },
+  );
+
+  it('rejects missing MIME and header controls before dispatch', () => {
+    expect(() => transcriptionFile(new Blob([]))).toThrow('MIME');
+    expect(() =>
+      transcriptionFile(new Uint8Array(), {
+        mediaType: 'audio/ogg\r\nX-Header: bad',
+      }),
+    ).toThrow('MIME');
+    expect(() =>
+      transcriptionFile(new Blob([], { type: 'audio/wav' }), {
+        filename: 'bad\nname',
+      }),
+    ).toThrow('filename');
+  });
+  it('uses the existing byte/MIME contract only when every supplied field can reach that adapter', async () => {
+    const payload = new Uint8Array([0, 4, 9, 0]).subarray(1, 3);
+    const doGenerate = vi.fn().mockResolvedValue(success);
+    const model = new MockTranscriptionModelV4({ doGenerate });
+    const audio = transcriptionFile(payload, { mediaType: 'video/quicktime' });
+    expect((await transcribe({ model, audio })).text).toBe('done');
+    expect(doGenerate.mock.calls[0][0].audio).toBe(payload);
+    expect(doGenerate.mock.calls[0][0].mediaType).toBe('video/quicktime');
+    await expect(
+      transcribe({ model, audio: { ...audio, filename: 'take.mov' } }),
+    ).rejects.toThrow('file upload');
+    expect(doGenerate).toHaveBeenCalledOnce();
+  });
+});
