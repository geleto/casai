+/** Place Opus packets on a coarse container clock using their intrinsic coded duration. */
+export class OpusPacketClock {
+	end: number | null = null;
+	private early = false;
+	constructor(private resolution: number) {}
+
+	advance(timestamp: number, data: Uint8Array, nextTimestamp?: number) {
+		const duration = parseOpusTocByte(data).durationInSamples / OPUS_SAMPLE_RATE;
+		const expected = this.end ?? timestamp;
+		const tick = (time: number) => Math.round(time * this.resolution);
+		const delta = tick(timestamp) - tick(expected);
+		const recovered = delta === 1 && (nextTimestamp === undefined ? this.early
+			: nextTimestamp >= timestamp && tick(nextTimestamp) <= tick(expected + duration));
+		const start = expected + (recovered ? 0 : Math.max(0, delta) / this.resolution);
+		this.early = delta < 0;
+		this.end = start + duration;
+		return { start, duration };
+	}
